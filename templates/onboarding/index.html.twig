{% extends 'base.html.twig' %}

{% block menu %}{% endblock %}

{% block content %}
    <div class="max-w-xl mx-auto py-12 px-4 flex flex-col justify-center min-h-screen">
        <h1 class="mb-12">Local MangaPlus</h1>

        <p class="text-center">
            This app automatically tracks and downloads the latest MangaPlus releases to your private library. Never miss a chapter and keep your collection available even after they expire online.
        </p>

        <p class="text-center">
            <strong>Let's set up your library.</strong><br/>Tell us which languages you read to start the synchronization.
        </p>

        <twig:OnboardingForm />
    </div>
{% endblock %}
