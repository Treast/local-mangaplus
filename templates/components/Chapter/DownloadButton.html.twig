<div {{ attributes.defaults({class: 'flex items-center justify-end gap-2'}) }} {% if this.chapter.downloadStatus == enum('App\\ImmutableValue\\DownloadStatus').Downloading %}data-poll{% endif %}>
    {% if this.chapter.downloadStatus == enum('App\\ImmutableValue\\DownloadStatus').Downloaded %}
        <twig:Button as="a" href="{{ path('app.chapters.read', {id: this.chapter.id}) }}" variant="default" size="icon" target="_blank" data-tippy-content="Read chapter">
            <twig:ux:icon name="lucide:eye" class="size-4" />
        </twig:Button>

        <twig:Button as="a" href="{{ path('app.chapters.save', {id: chapter.id}) }}" variant="default" size="icon" target="_blank" data-tippy-content="Save chapter">
            <twig:ux:icon name="lucide:download" class="size-4" />
        </twig:Button>
    {% elseif this.chapter.downloadStatus == enum('App\\ImmutableValue\\DownloadStatus').Downloading %}
        <twig:Button as="button" variant="outline" size="icon" disabled data-tippy-content="Downloading">
            <twig:ux:icon name="lucide:loader-circle" class="size-4 animate-spin" />
        </twig:Button>
    {% elseif this.chapter.downloadStatus == enum('App\\ImmutableValue\\DownloadStatus').DownloadingFailed %}
        <twig:Button
            as="button"
            variant="outline"
            size="icon"
            data-action="live#action"
            data-live-action-param="startDownload"
            data-tippy-content="Error while downloading"
        >
            <twig:ux:icon name="lucide:badge-info" class="size-4" />
        </twig:Button>
    {% else %}
        <twig:Button
            as="button"
            variant="outline"
            size="icon"
            data-action="live#action"
            data-live-action-param="startDownload"
            data-tippy-content="Download chapter"
        >
            <twig:ux:icon name="lucide:download" class="size-4" />
        </twig:Button>
    {% endif %}
</div>
